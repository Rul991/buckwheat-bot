include /utils/mixins.pug

-
    const type = item.isConsumable ? 
        range(1, 50) == 1 ? 
            choose(['Единоразовый', 'Одиноразовый']) : 
            'Одноразовый' : 
        'Многоразовый'

mixin condition(title, value)
    +plain_bold_param(title, bool(value))
    if value
        |       
        block
        |

b #{itemVars.emoji} #{itemVars.title}
|
|
blockquote(expandable) !{itemVars.description}
|
|
+plain_bold_param(`${EMOJIES.LIST} Тип`, type)
+plain_bold_param(`${EMOJIES.MONEY} Рыночная цена`, `${formatNumber(item.basePrice)}${EMOJIES.MONEY}`)
+plain_bold_param(`${EMOJIES.COUNT} Кол-во`, `x${formatNumber(inventoryItem.count)} ${item.isConsumable ? '' : `(${EMOJIES.INFINITY})`}`)
if item.rarity >= 0
    |
    |
    +condition(`${EMOJIES.WORK} Выпадает с работы`, item.drop.canDropFromWork)
        +plain_bold_param(`     ${EMOJIES.PERCENTS} Шанс выпадения`, `${percents.work}%`)
    +condition(`${EMOJIES.LOOTBOX} Выпадает с чудо-ящика`, item.drop.canDropFromLootBox)
        +plain_bold_param(`     ${EMOJIES.PERCENTS} Шанс выпадения`, `${percents.lootbox}%`)
|
|
+condition(`${EMOJIES.SHIELD} Щит`, item.shield)
    +plain_code_param(`     ${EMOJIES.MINUS} Прочность`, formatNumber(item.shield.durability))
+condition(`${EMOJIES.GUN} Оружие`, item.gun)
    - const [min, max] = item.gun.damage
    +plain_code_param(`     ${EMOJIES.MINUS} Урон`, `${formatNumber(min)} - ${formatNumber(max)}`)
    +plain_code_param(`     ${EMOJIES.MINUS} Патроны`, ammo)