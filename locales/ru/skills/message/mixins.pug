include /utils/mixins.pug

mixin method(emoji, title, texts)
    if texts.length
        |
        +heading(emoji)
            | На #{title}:
        |
        blockquote
            for text in texts
                | !{text}
                |
            |

mixin methods(casterMethods, targetMethods)
    +method(EMOJIES.TARGET, 'цель', targetMethods)
    |
    |
    +method(EMOJIES.CASTER, 'заклинателя', casterMethods)

mixin skill_heading(skill)
    +heading(EMOJIES.SKILL)
        | #{skill.title}
    |

mixin skill(options)
    - 
        const {
            skill,
            targetMethods,
            casterMethods
        } = options

    +skill_heading(skill)
    blockquote !{skill.description}
    |
    +plain_code_param(`${EMOJIES.LEVEL} Нужный уровень`, formatNumber(skill.level))
    |
    |
    |
    +methods(casterMethods, targetMethods)