include /utils/mixins.pug

if isKicked
    | #{EMOJIES.DEAD} 
    b
        +random([
            'Ой',
            'Упс',
            'Увы'
        ])
    | , 
    +random([
        'пуля вылетела из револьера и забрала вместе с собой игрока',
        'пуля помогла вылететь из чата игроку'
    ])
    |  
    +link(user)
    | !
else 
