{
  "name": "buckwheat-bot",
  "description": "Fan Favorite Chat Manager of Envell",
  "version": "2.0.0",
  "module": "src/app/index.ts",
  "scripts": {
    "dev": "bun run --watch src/app/index.ts",
    "start": "bun run src/app/index.ts",
    "start:prod": "bunx pm2 start pm2.config.js --env prod",
    "restart:prod": "bun install --production && bunx pm2 restart buckwheat-bot",
    "stop:prod": "bunx pm2 stop pm2.config.js && bunx pm2 delete pm2.config.js",
    "generate": "bunx protoc --es_out src/protos --es_opt target=ts --proto_path protos protos/*.proto",
    "migrate": "bun run src/app/migrate-db.ts",
    "check": "bunx tsc -b"
  },
  "keywords": [
    "grammy",
    "grully",
    "mongoose",
    "typegoose",
    "buckwheat",
    "bot",
    "telegram"
  ],
  "author": "Rul",
  "license": "CC BY-NC",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "@types/pug": "^2.0.10"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grully/i18n": "^1.0.3",
    "@grully/i18n-pug": "^1.0.2",
    "@typegoose/typegoose": "^13.4.0",
    "grammy": "^1.45.1",
    "mongoose": "^9.7.4",
    "telegram-transformer": "^1.4.0",
    "zod": "^4.6.5"
  }
}